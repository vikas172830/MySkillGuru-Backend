# ---- MongoDB (MySkillGuru has its OWN database; never the LMS one) ----
MONGODB_URI=mongodb://localhost:27017
DB_NAME=myskillguru

# ---- JWT ----
# Must differ from the LMS's secret. In production (ENV=production) the server
# refuses to start unless this is a random value of >= 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_DAYS=1
# Browsers scope cookies by host, not port — this MUST differ from the LMS's cookie.
JWT_COOKIE_NAME=myskillguru_access_token_cookie

# ---- App ----
ENV=development
# Comma-separated allowed frontend origins ("*" is rejected). MySkillGuru frontend = 3001.
CORS_ORIGINS=http://localhost:3001

# ---- AI / media ----
GEMINI_API_KEY=<api-key>
ANTHROPIC_API_KEY=<api-key>
YOUTUBE_API_KEY=
IMAGEKIT_PUBLIC_KEY=<public-key>
IMAGEKIT_PRIVATE_KEY=<private-key>
IMAGEKIT_URL_ENDPOINT=<https://ik.imagekit.io/your_id>
# Extra hostnames the server may fetch from (ImageKit host is always allowed). Optional.
OUTBOUND_FETCH_ALLOWED_HOSTS=

# ---- Redis ----
# Use a different DB index (/1) than the LMS if they share a Redis server.
REDIS_URL=redis://localhost:6379/1
# Prepended to every Redis key so two apps can never collide.
REDIS_KEY_PREFIX=myskillguru:

# ---- Qdrant (vector store) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Own collection — never the LMS's "lms_course_material_chunks".
QDRANT_COLLECTION=myskillguru_course_material_chunks
