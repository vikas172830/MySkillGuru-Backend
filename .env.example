# MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=lms_evaluation

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_DAYS=1

# App
ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Phase 2 — exams / evaluation / answer sheets
GEMINI_API_KEY=<api-key>
IMAGEKIT_PUBLIC_KEY=<public-key>
IMAGEKIT_PRIVATE_KEY=<private-key>
IMAGEKIT_URL_ENDPOINT=<https://ik.imagekit.io/your_id>

# Phase 3a — AI tutor / homework help / notes generation
ANTHROPIC_API_KEY=<api-key>
REDIS_URL=redis://localhost:6379
